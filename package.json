{
  "name": "local-dev-bridge-mcp",
  "version": "3.0.0",
  "description": "MCP server for Herdr agent/pane control and a file-based UAT test queue (Claude Code ↔ Cowork + Claude in Chrome). File/shell work moves to the native device bridge.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "node test/regression.mjs",
    "smoke:worker": "node test/worker-smoke.mjs",
    "worker": "node worker/uat-worker.mjs"
  },
  "keywords": [
    "mcp",
    "claude",
    "herdr",
    "uat",
    "testing",
    "browser",
    "claude-code",
    "claude-chrome"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.js",
    "lib/",
    "worker/",
    "launchd/"
  ]
}
